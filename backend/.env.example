# Database Configuration (PostgreSQL). Special characters in the password must be URL-encoded.
DATABASE_URL=postgresql+psycopg://dockyard_app:CHANGE_ME@localhost:5432/dockyard_inventory
# SQLite fallback for quick local experiments:
# DATABASE_URL=sqlite:///./dockyard_materials.db

# Application Settings
APP_NAME=Dockyard Materials Command
APP_VERSION=1.0.0
DEBUG=True

# CORS Settings (for Vite dev server)
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
